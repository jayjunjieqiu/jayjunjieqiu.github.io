---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ '/publications' | absolute_url }}</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ '/showcase' | absolute_url }}</loc>
    <priority>0.6</priority>
  </url>
  {% assign indexed_publications = site.publications | sort: 'date' | reverse %}
  {% for publication in indexed_publications %}
  <url>
    <loc>{{ publication.url | absolute_url }}</loc>
    {% if publication.date %}<lastmod>{{ publication.date | date_to_xmlschema }}</lastmod>{% endif %}
    <priority>0.7</priority>
  </url>
  {% endfor %}
  {% assign indexed_news = site.news | sort: 'date' | reverse %}
  {% for item in indexed_news %}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>
    {% if item.date %}<lastmod>{{ item.date | date_to_xmlschema }}</lastmod>{% endif %}
    <priority>0.5</priority>
  </url>
  {% endfor %}
</urlset>
